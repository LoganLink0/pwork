# PWORK 本地网关配置（复制本文件为 app/.env.local 后填写；.env.local 已被 .gitignore 忽略，永不进仓库和备份）
# API Key（必填）：DeepSeek / 智谱 / Moonshot 等任意 OpenAI 兼容接口的 Key
PWORK_LLM_API_KEY=
# 上游接口地址（可选，默认 DeepSeek；换厂商改这里，如 https://open.bigmodel.cn/api/paas/v4/chat/completions）
PWORK_LLM_BASE_URL=
# 固定模型（可选，推荐换厂商时设置）：设了网关会以它替换请求里的模型名——浏览器端存的旧模型名不用手改
# DeepSeek 当前官方模型名见 https://api-docs.deepseek.com（如 deepseek-flash / deepseek-v4-pro）
PWORK_LLM_MODEL=
# 网关端口（可选，默认 8788）
PWORK_GATEWAY_PORT=

# ---- 联网搜索（可选，调研分析「联网调研」用）----
# 默认跟随上方 LLM 上游并复用同一把 Key（DeepSeek → Search API ¥0.005/次；智谱 → web-search-pro ¥0.03/次）
# 只有换独立搜索服务商时才需要下面两项（如博查等，格式需网关适配）
PWORK_SEARCH_API_KEY=
PWORK_SEARCH_BASE_URL=
