# PWORK 本地网关配置（复制本文件为 app/.env.local 后填写；.env.local 已被 .gitignore 忽略，永不进仓库和备份）
# API Key（必填）：DeepSeek / 智谱 / Moonshot 等任意 OpenAI 兼容接口的 Key
PWORK_LLM_API_KEY=
# 上游接口地址（可选，默认 DeepSeek；换厂商改这里，如 https://open.bigmodel.cn/api/paas/v4/chat/completions）
PWORK_LLM_BASE_URL=
# 网关端口（可选，默认 8788）
PWORK_GATEWAY_PORT=

# ---- 联网搜索（可选，调研分析「联网调研」用）----
# 智谱 tools 端点（默认）；Key 不填且上方 LLM 上游是智谱时自动复用 LLM Key（同账号）
# 注意：搜索按次计费（web-search-pro ¥0.03/次），需账户有余额或 Coding Plan 搜索权益
PWORK_SEARCH_API_KEY=
# 搜索上游（可选，默认智谱 https://open.bigmodel.cn/api/paas/v4/tools）
PWORK_SEARCH_BASE_URL=
# 搜索模型（可选，默认 web-search-pro）
PWORK_SEARCH_MODEL=
