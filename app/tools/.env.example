# PWORK 本地网关配置（复制本文件为 app/.env.local 后填写；.env.local 已被 .gitignore 忽略，永不进仓库和备份）
# API Key（必填）：DeepSeek / 智谱 / Moonshot 等任意 OpenAI 兼容接口的 Key
PWORK_LLM_API_KEY=
# 上游接口地址（可选，默认 DeepSeek；换厂商改这里，如 https://open.bigmodel.cn/api/paas/v4/chat/completions）
PWORK_LLM_BASE_URL=
# 网关端口（可选，默认 8788）
PWORK_GATEWAY_PORT=
