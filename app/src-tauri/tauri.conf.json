{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PWORK",
  "version": "0.1.8",
  "identifier": "com.pwork.workbench",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5273",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "个人工作台 PWORK",
        "width": 1360,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: data:; connect-src 'self' https: http://127.0.0.1:* http://localhost:*; font-src 'self' data:; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; base-uri 'self'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../worker/src": "worker/src",
      "../../worker/scripts": "worker/scripts",
      "../../worker/package.json": "worker/package.json",
      "../../worker/package-lock.json": "worker/package-lock.json",
      "../../worker/wrangler.toml": "worker/wrangler.toml",
      "../../worker/schema.sql": "worker/schema.sql",
      "../../worker/seed-sources.sql": "worker/seed-sources.sql",
      "../../worker/tsconfig.json": "worker/tsconfig.json",
      "../../worker/部署向导.cmd": "worker/部署向导.cmd"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
